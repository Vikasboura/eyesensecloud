DB_HOST=localhost
DB_PORT=3306
DB_USER=root
LICENSE_DB_PASS=
DB_NAME=eyesense_licenses
LICENSE_API_SECRET=your_secure_random_hmac_secret_here

# ── Maintenance Receipt Uploads ──
# Absolute path to store uploaded receipt files (PDF/images).
# Must be writable by the web server. Defaults to api/uploads/maintenance_receipts/
# On production cloud server, set this to a path OUTSIDE the web root for security.
# Example: /var/data/eyesense_uploads/maintenance_receipts
MAINTENANCE_UPLOADS_DIR=

# ── INDSAC Email API ──
# URL for the INDSAC email sender API. Used for maintenance notifications.
INDSAC_EMAIL_API_URL=https://indsac.com/pge/SendIndsacEmail.php

# ── App Base URL ──
# Public URL where the EyeSense API folder is reachable (no trailing slash).
# Used to build links sent to clients (e.g. machine ID registration link).
#   Production : https://indsac.com/eyesense/api
#   Local dev  : http://localhost:8080
# EYESENSE_APP_BASE_URL=https://indsac.com/eyesense/api
EYESENSE_APP_BASE_URL=http://localhost:8080

# ── CORS Allowed Origins ──
# Comma-separated list of origins the PHP API accepts cross-origin requests from.
# Used by: verify_tenant.php, forgot_password_api.php
#   Production : https://indsac.com
#   Local dev  : http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080,http://127.0.0.1:8080
EYESENSE_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080,http://127.0.0.1:8080